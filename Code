import sys
import time

def jalanin_lirik():
    lirik = [
        ("\nMaybe tonight ", 0.12, 0.8),
        ("We don't gotta run away ", 0.1, 1.6),
        ("It's all a lie ", 0.12, 0.8),
        ("The baddest bitches ain't in LA ", 0.1, 1.2),
        ("Enjoy the ride ", 0.12, 0.8),
        ("I know that you might wanna escape ", 0.09, 1.4),
        ("It's all a lie ", 0.12, 0.8),
        ("The baddest bitches ain't in LA ", 0.09, 1.2),

    ]

    print("\n== Ain't In LA - ADELA ==")
    time.sleep(0.1)

    for baris_lagu, delay_karakter, delay_setelah in lirik:

        # Efek mengetik per karakter
        for karakter in baris_lagu:
            print(karakter, end="")
            sys.stdout.flush()
            time.sleep(delay_karakter)

        # Jeda mengikuti perpindahan nada/lirik
        time.sleep(delay_setelah)
        print("")

    print("// Code by Fanncode")

jalanin_lirik()
